// DeepSeek V4.1 Flash -- SYCL kernel launchers.

#include <utility>
#include <sycl/sycl.hpp>
#include <sycl/ext/intel/esimd.hpp>
#include <c10/core/Device.h>
#include <c10/xpu/XPUStream.h>
#include <torch/extension.h>

#include "../deepseek_v41/fp4_gemm.h"
#include "../deepseek_v41/topk_noaux_tc.h"

using namespace sycl::ext::intel::esimd;
using fp16 = sycl::half;

// The bias is one vector shared by every token, not a per-token row: it is a
// learned per-expert offset of shape [NUM_EXPERTS].
template <int NUM_EXPERTS, int TOP_K, int N_GROUP, int TOPK_GROUP>
struct DeepSeekTopKKernel {
    const fp16* logits;
    const fp16* bias;
    int* out_indices;
    fp16* out_weights;
    int batch_size;

    void operator()(sycl::nd_item<1> item) const SYCL_ESIMD_KERNEL {
        int token_idx = (int)item.get_global_id(0);
        if (token_idx >= batch_size) return;

        simd<fp16, NUM_EXPERTS> local_logits =
            block_load<fp16, NUM_EXPERTS>(logits + (size_t)token_idx * NUM_EXPERTS);
        simd<fp16, NUM_EXPERTS> local_bias = block_load<fp16, NUM_EXPERTS>(bias);

        simd<int, TOP_K> local_indices;
        simd<fp16, TOP_K> local_weights;

        compute_noaux_tc_routing<NUM_EXPERTS, TOP_K, N_GROUP, TOPK_GROUP>(
            local_logits, local_bias, local_indices, local_weights);

        // TOP_K is 4, 6 or 8; only powers of two are block-storable, so the
        // odd width goes out as scalars rather than reading past the row.
        if constexpr ((TOP_K & (TOP_K - 1)) == 0) {
            block_store<int, TOP_K>(out_indices + (size_t)token_idx * TOP_K, local_indices);
            block_store<fp16, TOP_K>(out_weights + (size_t)token_idx * TOP_K, local_weights);
        } else {
            #pragma unroll
            for (int k = 0; k < TOP_K; ++k) {
                out_indices[(size_t)token_idx * TOP_K + k] = local_indices[k];
                out_weights[(size_t)token_idx * TOP_K + k] = local_weights[k];
            }
        }
    }
};

void launch_fp4_gemm(
    torch::Tensor& a, 
    torch::Tensor& b_fp4, 
    torch::Tensor& b_scales, 
    torch::Tensor& c) 
{
    const int M = (int)a.size(0);
    const int K = (int)a.size(1);
    const int N = (int)b_fp4.size(0);

    sycl::queue& q = c10::xpu::getCurrentXPUStream(a.device().index()).queue();

    // One work-item owns 16 output channels and an M_TILE of rows. M_TILE is
    // chosen so the fp32 accumulator stays inside the small-GRF budget:
    // M_TILE * 16 floats, plus the unpacked B tile.
    constexpr int N_TILE = 16;
    constexpr int GROUP = 32;

    const size_t n_groups = (size_t)((N + N_TILE - 1) / N_TILE);

    auto launch = [&](auto m_tile_c) {
        constexpr int MT = decltype(m_tile_c)::value;
        const size_t m_groups = (size_t)((M + MT - 1) / MT);
        q.submit([&](sycl::handler& cgh) {
            FP4_GEMM_Kernel<MT, N_TILE, GROUP> kernel{
                reinterpret_cast<const fp16*>(a.data_ptr()),
                reinterpret_cast<const uint8_t*>(b_fp4.data_ptr()),
                reinterpret_cast<const uint8_t*>(b_scales.data_ptr()),
                reinterpret_cast<fp16*>(c.data_ptr()),
                M, N, K
            };
            cgh.parallel_for(
                sycl::nd_range<2>(sycl::range<2>(m_groups, n_groups),
                                  sycl::range<2>(1, 1)),
                kernel);
        });
    };

    // Decode is M==1; larger M amortises the weight stream over more rows.
    if (M == 1)      launch(std::integral_constant<int, 1>{});
    else if (M <= 4) launch(std::integral_constant<int, 4>{});
    else             launch(std::integral_constant<int, 8>{});
}

void launch_noaux_tc_topk(
    torch::Tensor& logits, 
    torch::Tensor& bias, 
    torch::Tensor& out_indices, 
    torch::Tensor& out_weights,
    int64_t top_k)
{
    int batch_size = logits.size(0);
    sycl::queue& q = c10::xpu::getCurrentXPUStream(logits.device().index()).queue();

    // Row-parallel with no SLM and no barrier, so the group width is free; a
    // one-item group would use one lane of a SIMD16 engine.
    constexpr int WG = 16;
    const size_t global = ((size_t)(batch_size + WG - 1) / WG) * WG;
    sycl::range<1> global_range(global);
    sycl::range<1> local_range(WG);

    auto submit_kernel = [&](auto top_k_val) {
        constexpr int TK = decltype(top_k_val)::value;
        q.submit([&](sycl::handler& cgh) {
            // DeepSeek V4.1: n_routed_experts 384 in 8 groups, 4 of which may
            // contribute to any one token.
            DeepSeekTopKKernel<384, TK, 8, 4> kernel{
                reinterpret_cast<const fp16*>(logits.data_ptr()),
                reinterpret_cast<const fp16*>(bias.data_ptr()),
                reinterpret_cast<int*>(out_indices.data_ptr()),
                reinterpret_cast<fp16*>(out_weights.data_ptr()),
                batch_size
            };
            cgh.parallel_for(sycl::nd_range<1>(global_range, local_range), kernel);
        });
    };

    switch (top_k) {
        case 4: submit_kernel(std::integral_constant<int, 4>{}); break;
        case 6: submit_kernel(std::integral_constant<int, 6>{}); break;  // V4.1 default
        case 8: submit_kernel(std::integral_constant<int, 8>{}); break;
        default:
            throw std::runtime_error("Unsupported top_k for DeepSeek V4.1 ESIMD kernel");
    }
}
